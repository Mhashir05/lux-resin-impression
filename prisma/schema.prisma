// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  price        String
  availability String
  category     String
  description  String
  images       String[]
  featured     Boolean  @default(false)
  isExclusive  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Order {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String
  items         Json
  totalAmount   Int
  paymentMethod String
  // "unpaid" for the manual methods (reconciled by hand); "paid" only after
  // Safepay's server-side signature verification succeeds.
  paymentStatus    String   @default("unpaid")
  // Safepay's tracker id once paid; unique so the same tracker can never be
  // replayed into a second order, independent of Safepay's own enforcement.
  paymentReference String?  @unique
  status           String   @default("New")
  createdAt        DateTime @default(now())

  // Courier is booked externally (Bykea, Yango, etc.) by the admin — these
  // just record what was booked, not a live tracking integration.
  courierService  String?
  riderName       String?
  riderPhone      String?
  trackingId      String?
  courierBookedAt DateTime?

  // Nullable: accounts are being introduced after checkout already existed,
  // so seed/legacy orders have no customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  statusHistory OrderStatusHistory[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteContent {
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// A tracker created server-side (via safepay.payments.create) for an
// authenticated customer's cart, recording the exact amount it was created
// for. The redirect-based checkout flow means the customer's browser leaves
// this app entirely to pay on Safepay's hosted page, so there's no request
// body to re-supply shipping/cart details when they're redirected back —
// app/api/payments/safepay/return/route.ts reads them from here instead, and
// re-prices from `items` to confirm nothing drifted since creation. Deleted
// once consumed so the same tracker can't be used twice.
model SafepayPendingTracker {
  id           String   @id
  amount       Int
  customerId   String
  customerName String
  phone        String
  address      String
  // { [productSlug]: quantity } — same shape parseCartItems produces.
  items        Json
  createdAt    DateTime @default(now())
}

model Customer {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  phone                String
  passwordHash         String
  address              String
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  orders               Order[]
}